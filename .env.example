# Copy this file to .env.local for local development. On Vercel, add the same names under
# Project Settings > Environment Variables. NEVER commit a real .env / .env.local file.

# ---- Admin login (REQUIRED) -------------------------------------------------------------
# These are checked on the SERVER only, so they are never shipped to anyone's browser.
# Fill in the admin email and password you want to use. (Keep the real values only in .env.local
# and in Vercel's Environment Variables — this example file is safe to commit, real values are not.)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# A long random string used to sign the login cookie (at least 32 characters). Make one up, e.g.
# run:  openssl rand -hex 32     or just mash 40+ random letters/numbers. Keep it secret.
ADMIN_SESSION_SECRET=

# ---- Firebase (OPTIONAL) ----------------------------------------------------------------
# Already defaults to the live tce-nahata project in src/firebase.js, the same one the student
# website uses. Only set these if you ever move to a different Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
